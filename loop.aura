; loop.aura — Strand closed loop (single file)
;
; Workspace function f starts as identity.
; Fitness = how many fixed abs-cases f already satisfies.
; Each round: query f → propose body → mutate:rebind → agent:decide
;   commit   → persist:save
;   rollback → ast:restore + hot-strategy:heal!
;   back-off → mutate:safe-yield and skip
; Prints agent:loop-stats and mutate:summary at the end.
;
; Host constraint: set-code / eval-current rebuild the workspace env.
; Do not (define x <expr-that-evals-current>). Drive the loop from a
; top-level named let + predeclared cells; workspace closures die.
;
; Run: ./scripts/run.sh
; Env: STRAND_PROPOSE=catalog|swarm|llm   STRAND_SOUL=path

(require "std/agent" all:)
(require "std/mutate" all:)
(require "std/persist" all:)
(require "std/hot-strategy" all:)
(require "std/swarm" all:)
(require "std/llm" all:)
(require "std/query" all:)
(require "std/string" all:)

(display "=== Strand: fitness / propose / decide / persist ===")
(newline)

; ── catalog bodies (data cells; not workspace functions) ──
(define *b0* "(lambda (x) x)")
(define *b1* "(lambda (x) (* x -1))")
(define *b2* "(lambda (x) (if (< x 0) (* x -1) x))")
(define *b3* "(lambda (x) 0)")
(define *b4* "(lambda (x) (* x 2))")
(define *poison* "(lambda (x) 99)")
(define *body-n* 5)
(define *case-n* 5)

; ── env / counters (predeclare; set! after seed / mutate) ──
(define *propose-mode* "catalog")
(define *env-p* "")
(define *soul* ".strand/session.aura-soul")
(define *env-s* "")
(define *rounds* 6)
(define *best* 0)
(define *best-body* "(lambda (x) x)")
(define *skip-left* 0)
(define *commits* 0)
(define *rollbacks* 0)
(define *backoffs* 0)
(define *escalations* 0)
(define *persists* 0)
(define *stopped* #f)
(define *stop-reason* "")
(define *last-decision* "none")
(define *seeded* #f)
(define *body* "(lambda (x) x)")
(define *snap* -1)
(define *pre* 0)
(define *post* 0)
(define *loop-r* #f)
(define *dec* 'none)
(define *okv* #f)
(define *gate* 'commit)
(define *final* 0)
(define *fit* 0)
(define *got* 0)
(define *nfit* 0)
(define *persist-ok* #f)
(define *raw* 0.0)
(define *idx* 0)
(define *code* "")
(define *resp* "")
(define *pass* #f)

(set! *env-p* (try (getenv "STRAND_PROPOSE") (catch (e) "")))
(if (and (string? *env-p*) (> (string-length *env-p*) 0))
  (set! *propose-mode* *env-p*)
  #f)

(set! *env-s* (try (getenv "STRAND_SOUL") (catch (e) "")))
(if (and (string? *env-s*) (> (string-length *env-s*) 0))
  (set! *soul* *env-s*)
  #f)

; ── seed workspace: only f. Must be top-level, not inside define. ──
(set-code "(define (f x) x)")
(eval-current)
(set! *seeded* #t)

; live-fit: score live f against the five abs cases. No inner let.
(define (live-fit)
  (set! *nfit* 0)
  (set! *got* (try (f -4) (catch (e) 99999)))
  (if (and (number? *got*) (= *got* 4)) (set! *nfit* (+ *nfit* 1)) #f)
  (set! *got* (try (f -1) (catch (e) 99999)))
  (if (and (number? *got*) (= *got* 1)) (set! *nfit* (+ *nfit* 1)) #f)
  (set! *got* (try (f 0) (catch (e) 99999)))
  (if (and (number? *got*) (= *got* 0)) (set! *nfit* (+ *nfit* 1)) #f)
  (set! *got* (try (f 2) (catch (e) 99999)))
  (if (and (number? *got*) (= *got* 2)) (set! *nfit* (+ *nfit* 1)) #f)
  (set! *got* (try (f 7) (catch (e) 99999)))
  (if (and (number? *got*) (= *got* 7)) (set! *nfit* (+ *nfit* 1)) #f)
  *nfit*)

(try (hot-strategy:register! "f" *b0*) (catch (e) #f))
(set! *best* (live-fit))
(set! *final* *best*)
(display "seeded f = identity  fitness=")
(display *best*)
(display "/")
(display *case-n*)
(newline)

; ── drive: named let (not a workspace define). ──
; closed-loop-once / eval-current run here via set! of predeclared cells.
(let loop ((n 1))
  (if (or *stopped* (> n *rounds*))
    #t
    (begin
      (set! *fit* (live-fit))
      (display "R")
      (display n)
      (display " observe fitness=")
      (display *fit*)
      (display " skip-left=")
      (display *skip-left*)
      (newline)
      (try (query :find "f") (catch (e) #f))
      (try (query :def-use "f") (catch (e) #f))
      (try (mutate:safe-yield) (catch (e) #f))

      (if (> *skip-left* 0)
        (begin
          (set! *skip-left* (- *skip-left* 1))
          (set! *last-decision* "skip")
          (display "  skip (back-off cooldown)")
          (newline))
        (begin
          (set! *gate* (try (agent:decide) (catch (e) 'commit)))
          (if (eq? *gate* 'escalate)
            (begin
              (set! *escalations* (+ *escalations* 1))
              (set! *stopped* #t)
              (set! *stop-reason* "escalate")
              (set! *last-decision* "escalate")
              (display "  escalate — stop")
              (newline))
            (if (eq? *gate* 'back-off)
              (begin
                (set! *backoffs* (+ *backoffs* 1))
                (set! *skip-left* 1)
                (set! *last-decision* "back-off")
                (try (mutate:safe-yield) (catch (e) #f))
                (display "  back-off — yield, cooldown 1")
                (newline))
              (begin
                ; propose
                (if (string=? *propose-mode* "llm")
                  (begin
                    (set! *code* "")
                    (set! *resp*
                      (try
                        (llm-ask "Return ONLY one Aura lambda that computes abs: (lambda (x) ...). No markdown.")
                        (catch (e) "")))
                    (set! *code* (try (extract-code *resp*) (catch (e) "")))
                    (if (and (string? *code*) (> (string-length *code*) 10))
                      (set! *body* *code*)
                      (set! *body* *b2*)))
                  (if (string=? *propose-mode* "swarm")
                    (begin
                      (try
                        (swarm:init (hash "kind" "grid"
                                          "dim" 1
                                          "pop" 5
                                          "bins" 5
                                          "bounds" (list (list 0.0 4.9))))
                        (catch (e) #f))
                      (try
                        (swarm:step!
                          (lambda (ind)
                            (if (pair? ind) (set! *raw* (car ind)) (set! *raw* ind))
                            (if (not (number? *raw*))
                              3
                              (if (< *raw* 1.0) 3
                                (if (< *raw* 2.0) 3
                                  (if (< *raw* 3.0) 5
                                    (if (< *raw* 4.0) 1 1)))))))
                        (catch (e) #f))
                      (set! *raw* (try (swarm:best) (catch (e) 0.0)))
                      (if (pair? *raw*) (set! *raw* (car *raw*)) #f)
                      (if (not (number? *raw*))
                        (set! *idx* 0)
                        (if (< *raw* 1.0) (set! *idx* 0)
                          (if (< *raw* 2.0) (set! *idx* 1)
                            (if (< *raw* 3.0) (set! *idx* 2)
                              (if (< *raw* 4.0) (set! *idx* 3)
                                (set! *idx* 4))))))
                      (if (= *idx* 0) (set! *body* *b0*)
                        (if (= *idx* 1) (set! *body* *b1*)
                          (if (= *idx* 2) (set! *body* *b2*)
                            (if (= *idx* 3) (set! *body* *b3*)
                              (set! *body* *b4*))))))
                    (begin
                      ; catalog: n=1 id, n=2 neg, n=3 poison, n=4 abs, n=5 zero, n=6 dbl
                      (if (= n 1) (set! *body* *b0*)
                        (if (= n 2) (set! *body* *b1*)
                          (if (= n 3) (set! *body* *poison*)
                            (if (= n 4) (set! *body* *b2*)
                              (if (= n 5) (set! *body* *b3*)
                                (set! *body* *b4*)))))))))

                ; Catalog R3 (and every proposer) injects poison so rollback is observable.
                (if (= n 3) (set! *body* *poison*) #f)

                (set! *snap* (try (ast:snapshot "r") (catch (e) -1)))
                (set! *pre* (live-fit))
                (set! *loop-r*
                  (try
                    (agent:closed-loop-once
                      :skip-set-code
                      :rebind "f" *body*
                      :summary (string-append "strand-r" (number->string n)))
                    (catch (e) (list (cons ":ok" #f)
                                     (cons ":decision" 'rollback)))))
                (set! *dec* 'rollback)
                (set! *okv* #f)
                (if (and (pair? *loop-r*) (pair? (car *loop-r*)))
                  (begin
                    (if (equal? (car (car *loop-r*)) ":ok")
                      (set! *okv* (cdr (car *loop-r*)))
                      #f)
                    (if (and (pair? (cdr *loop-r*)) (pair? (car (cdr *loop-r*))))
                      (if (equal? (car (car (cdr *loop-r*))) ":decision")
                        (set! *dec* (cdr (car (cdr *loop-r*))))
                        #f)
                      #f))
                  #f)
                (set! *post* (live-fit))
                (display "  propose ")
                (display *body*)
                (newline)
                (display "  closed-loop decision=")
                (display *dec*)
                (display " ok=")
                (display *okv*)
                (display " fitness ")
                (display *pre*)
                (display "→")
                (display *post*)
                (newline)

                (if (eq? *dec* 'escalate)
                  (begin
                    (set! *escalations* (+ *escalations* 1))
                    (set! *stopped* #t)
                    (set! *stop-reason* "escalate")
                    (set! *last-decision* "escalate")
                    (try (ast:restore *snap*) (catch (e) #f))
                    (try (hot-strategy:heal!) (catch (e) #f))
                    (try (eval-current) (catch (e) #f)))
                  (if (eq? *dec* 'back-off)
                    (begin
                      (set! *backoffs* (+ *backoffs* 1))
                      (set! *skip-left* 1)
                      (set! *last-decision* "back-off")
                      (try (ast:restore *snap*) (catch (e) #f))
                      (try (hot-strategy:heal!) (catch (e) #f))
                      (try (eval-current) (catch (e) #f))
                      (try (mutate:safe-yield) (catch (e) #f)))
                    (if (or (not *okv*) (eq? *dec* 'rollback) (< *post* *pre*))
                      (begin
                        (set! *rollbacks* (+ *rollbacks* 1))
                        (set! *last-decision* "rollback")
                        (try (ast:restore *snap*) (catch (e) #f))
                        (try (hot-strategy:heal!) (catch (e) #f))
                        (try (eval-current) (catch (e) #f))
                        (set! *final* (live-fit))
                        (display "  rollback fitness now=")
                        (display *final*)
                        (newline))
                      (begin
                        (set! *commits* (+ *commits* 1))
                        (set! *last-decision* "commit")
                        (set! *final* *post*)
                        (try (hot-strategy:register! "f" *body*) (catch (e) #f))
                        (if (> *post* *best*)
                          (begin
                            (set! *best* *post*)
                            (set! *best-body* *body*)
                            (set! *persist-ok* (try (persist:save *soul*) (catch (e) #f)))
                            (if *persist-ok* (set! *persists* (+ *persists* 1)) #f)
                            (display "  persist ")
                            (display *soul*)
                            (display " ")
                            (display *persist-ok*)
                            (newline))
                          (begin
                            (display "  commit (no fitness gain, skip persist)")
                            (newline))))))))))))
      (if (and *seeded*
               (not (< *commits* 1))
               (not (< *rollbacks* 1))
               (not (< *final* *best*))
               (not (< *final* 3)))
        (set! *pass* #t)
        (set! *pass* #f))
      (loop (+ n 1)))))

(display "---")
(newline)
(display "best fitness=")
(display *best*)
(display "/")
(display *case-n*)
(display " body=")
(display *best-body*)
(newline)
(display "live fitness=")
(display *final*)
(newline)
(display "commits=")
(display *commits*)
(display " rollbacks=")
(display *rollbacks*)
(display " backoffs=")
(display *backoffs*)
(display " escalations=")
(display *escalations*)
(display " persists=")
(display *persists*)
(newline)
(display "last=")
(display *last-decision*)
(display " stopped=")
(display *stopped*)
(display " reason=")
(display *stop-reason*)
(newline)

(display "agent:loop-stats ")
(display (try (agent:loop-stats) (catch (e) "n/a")))
(newline)
(display "mutate:summary ")
(display (try (mutate:summary) (catch (e) "n/a")))
(newline)
(display "mutate:last-info ")
(display (try (mutate:last-info) (catch (e) "n/a")))
(newline)

; Four seed criteria. Poison on catalog R3 must not stick.
; *pass* is folded each round — tail must not call >= / write
; (eval-current can drop those bindings).
(if *pass*
  (begin
    (display "PASS: strand closed loop (commit + rollback + stats)")
    (newline)
    (display "RESULT pass repo=strand")
    (newline))
  (begin
    (display "FAIL: seed criteria not met (need >=1 commit, >=1 rollback, live fitness >= 3)")
    (newline)
    (display "RESULT fail repo=strand")
    (newline)))
